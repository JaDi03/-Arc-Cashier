# ---------------------------------------------------------
# Circle User-Controlled Wallets (Required)
# If you don't know how to get these, follow the guides:
# - API Key: docs/tutorials/circle-api-key.md
# - App ID: docs/tutorials/circle-app-id.md
# ---------------------------------------------------------
CIRCLE_API_KEY=TEST_API_KEY:YOUR_KEY_HERE
CIRCLE_APP_ID=your_app_id_here
# Email OTP: configure SMTP in Circle Developer Console (Circle sends the mail).
# Social login (Google / Facebook): Client IDs from Circle Console → Social Logins.
CIRCLE_GOOGLE_CLIENT_ID=your_google_web_client_id
# Optional:
# CIRCLE_FACEBOOK_APP_ID=your_facebook_app_id
# Google OAuth authorized redirect URI must include the origin where viewers open the player.

# ---------------------------------------------------------
# Security
# ---------------------------------------------------------
# Encrypts ephemeral session keys at rest (32+ random characters).
MASTER_KEY=your_secure_master_key_here

# HMAC for POST /api/core/v1/sessions/start and /stop.
# Plugins send X-Tessera-Timestamp, X-Tessera-Nonce, X-Tessera-Signature.
TESSERA_INGEST_SECRET=your_ingest_hmac_secret_here

# Optional Arc Testnet RPC. If unset, defaults to https://rpc.testnet.arc.network
# ARC_RPC_URL=

# Public URL for the sidecar API (default http://localhost:7878)
PUBLIC_URL=http://localhost:7878

# Server port (default 7878)
PORT=7878

# MIN_WALLET_BALANCE=0.01
# RETAINED_GAS_AMOUNT=0.01
